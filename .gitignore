# Generated code (gen/) is COMMITTED so the examples build and run WITHOUT the (closed-source)
# dagr CLI — this repo is a self-contained reference. Only build artifacts under it are ignored.

# Build artifacts
target/
node_modules/
examples/swift/dst-swift
examples/mojo/dst-mojo
examples/odin/dst-odin
__mojocache__/
*.bin

# pixi env for the Mojo example (pixi.toml + pixi.lock are committed; the ~1 GB
# solved environment is not).
.pixi/

# Python / editor
__pycache__/
.build/
.swiftpm/

# bench-only PyJWT venv (created by run_bench.sh)
.bench-venv/

# closed-source dagr CLI artifacts (recreated only if you have the CLI + run `dagr build`)
dagr.lock.json
.dagr/
gen/python/

# Generated code (gen/) is COMMITTED so the examples build and run WITHOUT the dagr CLI — this
# repo is a self-contained reference. Only build artifacts under it are ignored.

# Build artifacts
target/
node_modules/
examples/swift/dst-swift
examples/mojo/dst-mojo
examples/odin/dst-odin
examples/go/dst-go
examples/cpp/dst-cpp
examples/c/dst-c
examples/java/build/
__mojocache__/
*.bin

# pixi env for the Mojo example (pixi.toml + pixi.lock are committed; the ~1 GB
# solved environment is not).
.pixi/

# Python / editor
__pycache__/
.build/
.swiftpm/

# bench-only PyJWT venv (created by run_bench.sh)
.bench-venv/

# dagr CLI scratch (dagr.lock.json, the generation receipt, IS committed: `dagr check` diffs it)
.dagr/

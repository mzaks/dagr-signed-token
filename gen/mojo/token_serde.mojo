    var _rawbits: UInt64 = 0
    var _pr0 = Bool(a._arr_claims[h._index()].subject)
    var _pr1 = Bool(a._arr_claims[h._index()].issuer)
    var _pr2 = Bool(a._arr_claims[h._index()].audience)
    var _pr5 = True
    var _pr6 = Bool(h.custom())
    if _pr6:
        _ = _store_union_packed_json(b, a, h.custom().value())
    ref _pa5 = a._arr_claims[h._index()].scopes
    var _pcb5 = b.cursor
    for _k5 in range(len(_pa5) - 1, -1, -1):
        _ = b.store_utf8(_pa5[_k5], False)
    _ = b.store_leb(UInt64(len(_pa5)))
    _ = b.store_leb(UInt64(b.cursor - _pcb5))
    if leb_length(UInt64(h.expires_at())) < 8:
        _ = b.store_leb(UInt64(h.expires_at()))
    else:
        _ = b.store_u64(h.expires_at())
        _rawbits |= UInt64(1) << 1
    if leb_length(UInt64(h.issued_at())) < 8:
        _ = b.store_leb(UInt64(h.issued_at()))
    else:
        _ = b.store_u64(h.issued_at())
        _rawbits |= UInt64(1) << 0
    if _pr2:
        _ = b.store_utf8(a._arr_claims[h._index()].audience.value(), False)
    if _pr1:
        _ = b.store_utf8(a._arr_claims[h._index()].issuer.value(), False)
    if _pr0:
        _ = b.store_utf8(a._arr_claims[h._index()].subject.value(), False)
    _ = b.store_u8(UInt8(_rawbits & 0xff))
    var _pb: UInt64 = 0
    if _pr0:
        _pb |= UInt64(1) << 0
    if _pr1:
        _pb |= UInt64(1) << 1
    if _pr2:
        _pb |= UInt64(1) << 2
    if _pr5:
        _pb |= UInt64(1) << 3
    if _pr6:
        _pb |= UInt64(1) << 4
    _ = b.store_u8(UInt8(_pb & 0xff))
    _ = b.store_leb(UInt64(b.cursor - _before))

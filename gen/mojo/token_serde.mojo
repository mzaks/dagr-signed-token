    var _hbytes = _hb.make_data()
    var _so = _oo + len(_hbytes)                 # stored_offset = original + H
    var _out = List[UInt8]()
    _push_leb(_out, (UInt64(_so) << 2) | 1)      # framing: header_bit=1, DataGraph
    _push_bytes(_out, _hbytes)
    _push_bytes(_out, _body)
    return _out^


def read_claims_header[o: ImmOrigin](buf: Span[UInt8, o]) raises -> Jws:
    # Decode the packed header sitting immediately after the framing word (§3).
    var _fr = read_leb(buf, 0)
    return _restore_jws(buf, _fr[1])

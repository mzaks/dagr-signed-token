def _store_claims[o: Origin[mut=False], //](mut b: Builder[_VT_MAX], a: TokenArena, h: Claims[o]) raises -> NodeStoreRef:
    var _id = _nid(0, h._index())
    if _id in b.struct_lookup:
        return resolved_ref(b.struct_lookup[_id])

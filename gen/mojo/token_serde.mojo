    _ = b.store_leb(UInt64((b.cursor - _off) << 2))    # framing (no header)
    return b.make_data()


def serialize_claims_graph_with_header(a: TokenArena, var header: Jws) raises -> List[UInt8]:
    # §14: [framing (stored_offset<<2 | header_bit)][packed header][body].
    # stored_offset = original_offset + H accounts for the inserted header (§4),
    # so the reader's root_offset still lands on the root unchanged.

def read_claims_root_with_header[
    o: ImmOrigin, //,
    gate: def(JwsAccessor[ImmutAnyOrigin], Int, Span[UInt8, ImmutAnyOrigin]) raises capturing[_] -> None,
](buf: Span[UInt8, o]) raises -> ClaimsAccessor[o]:
    if len(buf) == 0:
        raise Error("dagr: empty buffer")
    var _fr = read_leb(buf, 0)
    var _framing = _fr[0]
    if (_framing & 1) != 1:
        raise Error("dagr: not a header-framed DataGraph")
    if ((_framing >> 1) & 1) != 0:
        raise Error("dagr: root node is deleted")
    var _rl = _fr[1]
    var _stored = Int(_framing >> 2)
    var _hcs = read_leb(buf, _rl)
    var _h = _hcs[1] + Int(_hcs[0])
    var _header = JwsAccessor[ImmutAnyOrigin](rebind[Span[UInt8, ImmutAnyOrigin]](buf), _rl)   # lazy header view at the framing tail
    # body as a zero-copy subview of `buf` (no List materialization); rebind erases
    # the tracked origin to the gate's ImmutAnyOrigin (same ptr+len representation).
    gate(_header, _stored - _h, rebind[Span[UInt8, ImmutAnyOrigin]](buf[_rl + _h:]))   # verify-before-parse; raises to reject
    var _at = _rl + _stored
    if _at >= len(buf):
        raise Error("dagr: root offset out of range")
    return ClaimsAccessor[o](buf, _at)
